<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light"
    tools:context=".ui.student.home.presence.StudentPresenceFragment">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:layout_marginHorizontal="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:id="@+id/chipAhad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ahad" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:id="@+id/chipSenin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senin" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:id="@+id/chipSelasa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selasa" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:id="@+id/chipRabu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rabu" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:id="@+id/chipKamis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kamis" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:id="@+id/chipJumat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jumat" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:id="@+id/chipSabtu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sabtu" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="1dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jadwal Sekolah"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="23 Januari 2026"
                        android:textSize="12sp"/>

                    <LinearLayout
                        android:id="@+id/ll_empty"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <com.airbnb.lottie.LottieAnimationView
                            android:layout_width="192dp"
                            android:layout_height="192dp"
                            android:layout_gravity="center"
                            app:lottie_rawRes="@raw/lottie_empty"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Data Tidak Ditemukan!"
                            android:textSize="16sp"/>

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_schedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:listitem="@layout/item_student_schedule"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kegiatan Pesantren"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/colorPrimary"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/white">

                        <LinearLayout
                            android:id="@+id/ll_presence_tahfidz"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_margin="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tahfidz"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:id="@+id/tv_tahfidz_morning"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="• Pagi: Belum Absen"
                                    android:textColor="@color/black"/>

                                <TextView
                                    android:id="@+id/tv_tahfidz_evening"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="• Sore: Belum Absen"
                                    android:textColor="@color/black"/>
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_right_arrow"
                                app:tint="@color/colorPrimary"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/colorPrimary"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/white">

                        <LinearLayout
                            android:id="@+id/ll_presence_prayer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_margin="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Shalat"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:id="@+id/tv_shalat_shubuh"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="• Shubuh: Belum Absen"
                                    android:textColor="@color/black"/>

                                <TextView
                                    android:id="@+id/tv_shalat_dzuhur"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="• Dhuhur: Belum Absen"
                                    android:textColor="@color/black"/>

                                <TextView
                                    android:id="@+id/tv_shalat_ashar"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="• Ashar: Belum Absen"
                                    android:textColor="@color/black"/>

                                <TextView
                                    android:id="@+id/tv_shalat_maghrib"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="• Maghrib: Belum Absen"
                                    android:textColor="@color/black"/>

                                <TextView
                                    android:id="@+id/tv_shalat_isya"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="• Isya: Belum Absen"
                                    android:textColor="@color/black"/>
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_right_arrow"
                                app:tint="@color/colorPrimary"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>
</LinearLayout>